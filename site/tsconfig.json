{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "rootDir": ".",
    "outDir": ".compiled",
    "paths": {
      "@decisive/browser/*": [
        "../browser/dist/*"
      ]
    },
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "workers/*.ts",
    "lib/*.ts"
  ]
}
